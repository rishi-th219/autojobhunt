{
  "manifest_version": 3,
  "name": "AutoJobHunt In-Browser Assistant",
  "version": "1.0.0",
  "description": "Autofills job applications directly inside your current logged-in browser session (Brave/Chrome).",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "AutoJobHunt Auto-Fill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.workday.com/*",
        "*://*.naukri.com/*",
        "*://*.instahyre.com/*",
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
